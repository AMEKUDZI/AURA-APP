rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──
    // Anyone authenticated can read user profiles (needed for contact list)
    // Only the owner can write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Private Chats ──
    // Chat room ID must be built as: [uid1]_[uid2] sorted alphabetically
    // Only the two participants can read or write
    match /chats/{chatId} {
      allow read, write: if request.auth != null
        && request.auth.uid in resource.data.members;

      // Allow creating a new chat room if the requester is one of the members
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;

      // Messages subcollection — only members of the parent chat
      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.uid == request.auth.uid;
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow delete: if request.auth != null
          && request.resource.data.uid == request.auth.uid;
      }
    }

    // ── Presence ──
    // Anyone authenticated can read presence (for typing / online indicators)
    // Only owner can write their own presence
    match /aura_presence/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Admin broadcast (read-only global feed) ──
    match /aura_broadcast/{msgId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Groups ──
    match /groups/{groupId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.admins;

      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null
          && request.resource.data.uid == request.auth.uid;
      }
    }

    // ── Reports ──
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if false;
    }
  }
}
